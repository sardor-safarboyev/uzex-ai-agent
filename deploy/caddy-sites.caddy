
# ---- UZEX AI agent (vitality) — added by /opt/uzex/app/deploy/auto-deploy.sh; TLS by Caddy/Let's Encrypt ----
vitality.comma.uz, vitality-api.comma.uz {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy 172.17.0.1:18080 {
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 180s
		}
	}
}
