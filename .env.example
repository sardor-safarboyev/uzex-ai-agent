# Optional application settings. No database or Groq key is required for startup.
UZEX_APP_NAME="UZEX AI Agent"
UZEX_DATABASE_METADATA_ENABLED=false
UZEX_DATABASE_THREADS=2
UZEX_DATABASE_MEMORY_MB=256
UZEX_DATABASE_MAX_CONNECTIONS=2
UZEX_DATABASE_QUERY_TIMEOUT_MS=5000
UZEX_DATABASE_METADATA_MAX_COLUMNS=2000

# For local uvicorn, export an existing absolute database path in your shell.
# Compose uses a container path instead:
# UZEX_DATABASE_PATH=/data/uzex.duckdb
# Optional Compose overlay: existing host directory mounted read-only at /data.
# UZEX_DATABASE_DIRECTORY=/absolute/path/to/existing/database-directory
